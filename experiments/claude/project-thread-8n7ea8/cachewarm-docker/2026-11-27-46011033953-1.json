{
  "schemaVersion": 1,
  "suite": "cachewarm-docker",
  "workload": {
    "name": "Cache impact: cold vs warm Docker build (experiment)",
    "description": "Pairs of jobs per runner on PostHog's production Dockerfile (docker suite commit). Cold: fresh BuildKit builder, no cache-from, layers exported with cache-to type=gha,mode=max under a scope no job used before; the job fails if any step is CACHED. Warm: a fresh runner and builder import that scope (cache-from) and rebuild; it fails if nothing is CACHED. type=gha goes where the provider routes the GitHub cache (RunsOn Magic Cache, Blacksmith, Ubicloud, Avrea with url_v2=https://cache.avrea.com/), GitHub's cache otherwise.",
    "repository": "https://github.com/PostHog/posthog",
    "ref": "ba81ecf8f5bccbaee4ec5a1613780e0acfd7585b"
  },
