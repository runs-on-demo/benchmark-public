{
  "schemaVersion": 1,
  "suite": "codex",
  "workload": {
    "name": "Rust: OpenAI Codex",
    "description": "Cold build of openai/codex's Rust workspace (codex-rs: 214 crates, about 1,500 dependencies) at rust-v0.172.0, no cache: checkout, apt dependencies, toolchain, cargo fetch (its own phase: crates plus a git fork of rusty_v8, so mostly network), the V8 prebuilt library from Codex's releases, a debug build of the codex binary, and cargo clippy --tests on the whole workspace except codex-voice-host (it needs GStreamer 1.28, newer than Ubuntu 24.04's), lints as warnings. It needs about 11 GB for target/ and 5.4 GB for ~/.cargo: runners with less free disk or 8 GB of RAM without swap fail it. RunsOn runners ask for an 80 GB root volume (volume=80gb), as in the docker suite. It runs on each provider's 4 vCPU runner only, x64 and arm64.",
    "repository": "https://github.com/openai/codex",
    "ref": "3d86e43b075adeba2193ec5c22ac92f55afd82e6",
    "toolchain": "rust 1.99.1",
    "fetch": "cargo fetch is timed as its own phase, apart from compilation"
  },
