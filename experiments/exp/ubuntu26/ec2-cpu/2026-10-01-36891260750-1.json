{
  "schemaVersion": 1,
  "suite": "ec2-cpu",
  "workload": {
    "name": "EC2 CPU",
    "description": "The hardware suite's CPU groups only (sysbench single and multi-thread, 7-Zip, PassMark PerformanceTest CPU tests) on one instance per EC2 type, at the smallest 2 vCPU size (.large, or .medium for burstable t types), spot, EBS or local NVMe as the type comes. It measures EC2 CPU per instance type, not a CI runner, so its runners never join a race suite. It is the open replacement for the earlier private EC2 CPU sweep, and covers the same instance types. PassMark 'CPU Single Threaded' (metrics.cpu.passmarkSingle, million operations per second) is the figure that sweep recorded as 'speed': same test, same unit. Settings differ: that sweep ran pt_linux with 1 process, 5 iterations and short test duration; this suite runs it with one process per vCPU, 2 iterations and medium duration (the process count only affects the multi-threaded tests and CPU Mark). The earlier private sweep ran V11 (11.0.1002) on x64 and V10.2 (10.2.1003) on Graviton; the harness's single-threaded figures match it within about 1% on both.",
    "groups": [
      "cpu",
      "passmark"
    ],
    "passmark": "PassMark PerformanceTest Linux V11 (latest V11 build from passmark.com), pt_linux -r 1 -i 2 -p <vCPUs> -d 2",
    "metric": "metrics.cpu.passmarkSingle"
  },
